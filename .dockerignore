# Ignore everything
*

# Allow bin and src directories
!/src
!/bin

# Cargo.toml declares the tests and the bench as targets, and cargo refuses a
# manifest whose targets are missing
!/tests
!/benches
/tests/**/target

# Allow cargo files
!Cargo.toml
!Cargo.lock

# Allow .sqlx directory
!.sqlx

# Ignore unnecessary files inside allowed directories
# This should go after the allowed directories
**/*~
**/*.log
**/.DS_Store
**/Thumbs.db
